# Скопируйте в .env.local (локально) или задайте в Vercel → Settings → Environment Variables.
# Реальные ключи в репозиторий НЕ коммитить.

# Адрес сайта без слеша в конце, например https://ai-consultant-six.vercel.app
BASE_URL=
NEXT_PUBLIC_BASE_URL=

# ИИ (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Необязательно: модель для ответов виджета (по умолчанию deepseek/deepseek-chat)
OPENROUTER_MODEL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# service_role: только для сервера, никогда не добавляйте NEXT_PUBLIC_ к этому ключу
SUPABASE_SERVICE_ROLE_KEY=

# ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта (https://resend.com → API Keys). EMAIL_FROM — адрес на подтверждённом в Resend домене
EMAIL_API_KEY=
EMAIL_FROM=
